HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/onewarden.sqlite3
BACKUP_FOLDER=./data/backups
SENDS_FOLDER=./data/sends
ATTACHMENTS_FOLDER=./data/attachments
# Scheduled-job intervals in seconds; set an individual interval to 0 to disable it.
JOB_SEND_PURGE_INTERVAL=3600
JOB_AUTH_REQUEST_PURGE_INTERVAL=3600
JOB_EVENT_PURGE_INTERVAL=3600
JOB_EMERGENCY_ACCESS_TIMEOUT_INTERVAL=3600
JOB_EMERGENCY_ACCESS_REMINDER_INTERVAL=3600
JOB_INCOMPLETE_2FA_NOTIFICATION_INTERVAL=60
JOB_TRASH_PURGE_INTERVAL=86400
JOB_INCOMPLETE_SSO_PURGE_INTERVAL=86400
LOG_LEVEL=info
PROXY=false
ENABLE_WEBSOCKET=true
# Required in production. Use HTTPS except for localhost development.
# PUBLIC_ORIGIN=https://onewarden.contentoren.de
# SMTP is server-only and required when MAIL_ENABLED=true.
# SMTP_HOST=email.contentoren.de
# SMTP_PORT=587
# SMTP_USERNAME=auth@contentoren.de
# SMTP_PASSWORD=
# SMTP_FROM=auth@contentoren.de
# SMTP_TIMEOUT=15
# SMTP uses STARTTLS with certificate verification; insecure TLS overrides are not supported.
# Opt-in Mailcow E2E. The test derives a unique plus-tagged recipient from
# ONEWARDEN_E2E_RECIPIENT and deletes only the matching messages from this IMAP mailbox.
# The configured Mailcow address must accept plus-tagged delivery to this mailbox.
# Set every required variable below; leave ONEWARDEN_E2E_MAILCOW_ENABLED unset otherwise.
# ONEWARDEN_E2E_MAILCOW_ENABLED=true
# ONEWARDEN_E2E_BASE_URL=https://onewarden.contentoren.de
# ONEWARDEN_E2E_RECIPIENT=e2e-customer@contentoren.de
# ONEWARDEN_E2E_IMAP_HOST=email.contentoren.de
# ONEWARDEN_E2E_IMAP_PORT=993
# ONEWARDEN_E2E_IMAP_USERNAME=e2e-customer@contentoren.de
# ONEWARDEN_E2E_IMAP_PASSWORD=
# ONEWARDEN_E2E_IMAP_MAILBOX=INBOX
# Optional polling controls, in seconds.
# ONEWARDEN_E2E_IMAP_TIMEOUT_SECONDS=120
# ONEWARDEN_E2E_IMAP_POLL_SECONDS=2
# Run with: bun run test:e2e:mailcow
PUSH_ENABLED=false
PUSH_RELAY_URI=https://push.bitwarden.com
PUSH_IDENTITY_URI=https://identity.bitwarden.com
# PUSH_INSTALLATION_ID=
# PUSH_INSTALLATION_KEY=
SIGNUPS_ALLOWED=true
SIGNUPS_VERIFY=false
SIGNUPS_VERIFY_RESEND_TIME=3600
SIGNUPS_VERIFY_RESEND_LIMIT=6
# SIGNUPS_DOMAINS_WHITELIST=example.com
ORG_CREATION_USERS=
INVITATIONS_ALLOWED=true
INVITATION_EXPIRATION_HOURS=120
EMERGENCY_ACCESS_ALLOWED=true
PASSWORD_ITERATIONS=600000
PASSWORD_HINTS_ALLOWED=true
MAIL_ENABLED=false
ENABLE_EMAIL_2FA=false
EMAIL_TOKEN_SIZE=6
EMAIL_EXPIRATION_TIME=600
EMAIL_ATTEMPTS_LIMIT=3
INCOMPLETE_2FA_TIME_LIMIT=3
DUO_ENABLED=true
# DUO_HOST=
# DUO_IKEY=
# DUO_SKEY=
# YUBICO_ENABLED=false
# YUBICO_CLIENT_ID=
# YUBICO_SECRET_KEY=
# YUBICO_SERVER=https://api.yubico.com
UNAUTHENTICATED_RATELIMIT_SECONDS=60
UNAUTHENTICATED_RATELIMIT_MAX_BURST=50
