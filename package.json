{
  "name": "onewarden",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "imports": {
    "#result": "@adaptive-ds/result",
    "#ui/*": "./ui/*"
  },
  "scripts": {
    "server": "bun run src/server/serverStart.ts",
    "web": "vite",
    "compatibility:manifest": "bun run tools/compatibility/upstreamRouteManifestGenerate.ts",
    "compatibility:manifest:check": "bun run tools/compatibility/upstreamRouteManifestCheck.ts",
    "build": "bun run build:web",
    "build:web": "vite build",
    "format": "biome format --write src tests tools/compatibility/*.ts vite.config.ts package.json tsconfig.json biome.json",
    "format:check": "biome format src tests tools/compatibility/*.ts vite.config.ts package.json tsconfig.json biome.json",
    "lint": "biome lint src tests tools/compatibility/*.ts vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test --conditions=browser tests/unit",
    "test:integration": "bun test --conditions=browser tests/integration",
    "test:compatibility": "bun test --conditions=browser tests/compatibility",
    "test": "bun run test:unit && bun run test:integration && bun run test:compatibility",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@adaptive-ds/result": "0.6.0",
    "hono": "4.13.2",
    "jose": "^6.2.10",
    "solid-js": "1.9.15",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@biomejs/biome": "2.5.2",
    "@happy-dom/global-registrator": "20.11.12",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "babel-preset-solid": "^1.9.15",
    "happy-dom": "20.11.12",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14"
  }
}
