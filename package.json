{
  "name": "onewarden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  },
  "imports": {
    "#result": "@adaptive-ds/result",
    "#ui/*": "./ui/*",
    "#ui/*.js": "./ui/*.ts",
    "#ui/*.jsx": "./ui/*.tsx",
    "#utils/*": "@adaptive-ds/utils/*"
  },
  "scripts": {
    "server": "bun run src/server/serverStart.ts",
    "backup": "bun run tools/backup/backupCli",
    "restore": "bash ops/restore.sh",
    "web": "vite",
    "compatibility:manifest": "bun run tools/compatibility/upstreamRouteManifestGenerate.ts",
    "compatibility:manifest:check": "bun run tools/compatibility/upstreamRouteManifestCheck.ts",
    "extension": "vite --config src/extension/vite.config.ts",
    "deploy": "bun run frontend:deploy",
    "frontend:build": "bun run build",
    "frontend:upload": "bunx wrangler pages deploy ./dist/client --project-name=onewarden-site --branch main --commit-dirty=true",
    "frontend:deploy": "bun run frontend:build && bun run frontend:upload",
    "backend:package": "bash ops/backend-package.sh",
    "release:verify": "bun run tools/release/releaseVerify.ts",
    "backend:build": "bun run build:vault && bun run backend:package",
    "backend:deploy": "bun run backend:build && bash ops/deploy.sh",
    "release:verify:predeploy": "bun run tools/release/releasePredeployVerify.ts",
    "release:verify:postdeploy": "bun run tools/release/releasePostdeployVerify.ts",
    "build": "vite build && bun run seo:check",
    "build:web": "vite build",
    "build:vault": "vite build --config vite.web.config.ts",
    "build:extension": "vite build --config src/extension/vite.config.ts",
    "format": "biome format --write src test vite.config.ts wrangler.jsonc package.json assets.config.json",
    "format:check": "biome format src test vite.config.ts wrangler.jsonc package.json assets.config.json",
    "lint": "biome lint src tests tools/compatibility/*.ts tools/backup/*.ts tools/release/*.ts vite.config.ts playwright.config.ts",
    "typecheck": "bun tsc --noEmit",
    "test:unit": "bun test --conditions=browser tests/unit",
    "test:integration": "bun test --conditions=browser tests/integration",
    "test:compatibility": "bun test --conditions=browser tests/compatibility",
    "test:browser": "playwright test",
    "test:e2e:mailcow": "bun test tests/e2e/task5Mailcow.e2e.test.ts",
    "test": "bun test --max-concurrency=1",
    "check": "bun run format:check && bun run typecheck && bun run test",
    "dev": "vite dev",
    "preview": "vite preview",
    "seo:check": "bun run src/seoOutputCheck.ts",
    "frontend:create": "bunx wrangler pages project create onewarden-site --production-branch=main",
    "assets": "assets",
    "assets:upload": "bun run assets upload-all . --integration-note \"Update project assets\" --wait --json",
    "assets:list": "bun run assets list --include outputs,metadata,history --json",
    "assets:lists": "bun run assets lists --dir src/app/assets",
    "assets:lists:check": "bun run assets lists --check --dir src/app/assets",
    "assets:check": "bun run assets:lists:check",
    "assets:doctor": "bun run assets doctor --environment development --json"
  },
  "dependencies": {
    "@adaptive-ds/assets-service": "^0.6.0",
    "@adaptive-ds/mdi": "^0.1.2",
    "@adaptive-ds/result": "0.6.0",
    "@adaptive-ds/utils": "^0.13.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@corvu/dialog": "^0.2.4",
    "@corvu/popover": "^0.2.0",
    "@simplewebauthn/server": "^13.3.3",
    "@solid-primitives/keyed": "^1.5.3",
    "@solid-primitives/scheduled": "^1.5.3",
    "@solidjs/router": "^1.0.0",
    "cn": "^0.2.4",
    "corvu": "^0.7.2",
    "dayjs": "^1.11.20",
    "drizzle-orm": "^0.45.2",
    "hash-wasm": "^4.12.0",
    "hono": "4.13.2",
    "jose": "^6.2.10",
    "nodemailer": "^9.0.6",
    "solid-js": "^1.9.15",
    "tldts": "^7.4.11",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@biomejs/biome": "^2.5.2",
    "@crxjs/vite-plugin": "2.7.1",
    "@happy-dom/global-registrator": "20.11.12",
    "@playwright/test": "^1.62.1",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/chrome": "^0.2.7",
    "@types/nodemailer": "^8.0.1",
    "babel-preset-solid": "^1.9.15",
    "happy-dom": "20.11.12",
    "imapflow": "^1.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "@types/node": "^22.5.4",
    "ai-src": "^0.1.0",
    "wrangler": "^4.100.0"
  },
  "description": "A public Solid website built with Adaptive DS.",
  "sideEffects": false
}
