[Unit]
Description=OneWarden production server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/current/dist
EnvironmentFile=%h/.config/onewarden/prodctl-ports.env
EnvironmentFile=%h/.config/onewarden/.env.production
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/env bash %h/current/ops/prod/start.bash
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
