{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "incremental": false
  },
  "include": ["ui", "src/web", "src/outputs/web.ts", "src/packageName.ts", "src/packageVersion.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "build"]
}
