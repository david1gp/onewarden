# Protected production environment for OneWarden.
# Install outside the release tree, owned by the app user, with mode 600:
#   install -d -m 700 ~/.config/onewarden
#   install -m 600 .env.production.example ~/.config/onewarden/.env.production
# Then replace any marked values before deploying. Never commit .env.production.

HOST=127.0.0.1
# PORT is supplied by prodctl's ~/.config/onewarden/prodctl-ports.env.
PUBLIC_ORIGIN=https://onewarden.contentoren.de

# Relative storage defaults are redirected by ops/prod/start.bash to the
# persistent ~/.local/share/onewarden directory. Keep these commented unless
# an explicit absolute path or S3 location is intended.
# DATABASE_PATH=./data/onewarden.sqlite3
# SENDS_FOLDER=./data/sends
# ATTACHMENTS_FOLDER=./data/attachments
# BACKUP_FOLDER=./data/backups
# ICON_CACHE_FOLDER=./data/icon_cache

SENDS_ALLOWED=true
LOG_LEVEL=info
PROXY=false
IP_HEADER=X-Real-IP
IP_HEADER_TRUSTED_PROXIES=local
ENABLE_WEBSOCKET=true
WEB_VAULT_ENABLED=true
WEB_VAULT_FOLDER=./build/web

# Optional S3-compatible attachment storage; provision credentials separately.
# ATTACHMENTS_FOLDER=s3://contentoren-onewarden/production
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# Scheduled jobs, in seconds; set an interval to 0 to disable it.
JOB_SEND_PURGE_INTERVAL=3600
JOB_AUTH_REQUEST_PURGE_INTERVAL=3600
JOB_EVENT_PURGE_INTERVAL=3600
JOB_EMERGENCY_ACCESS_TIMEOUT_INTERVAL=3600
JOB_EMERGENCY_ACCESS_REMINDER_INTERVAL=3600
JOB_INCOMPLETE_2FA_NOTIFICATION_INTERVAL=60
JOB_TRASH_PURGE_INTERVAL=86400
JOB_INCOMPLETE_SSO_PURGE_INTERVAL=86400
JOB_SESSION_HANDOFF_PURGE_INTERVAL=60

# Identity and signup policy.
ORG_EVENTS_ENABLED=false
ORG_CREATION_USERS=
SIGNUPS_ALLOWED=true
SIGNUPS_VERIFY=false
SIGNUPS_VERIFY_RESEND_TIME=3600
SIGNUPS_VERIFY_RESEND_LIMIT=6
SIGNUPS_DOMAINS_WHITELIST=
INVITATIONS_ALLOWED=true
INVITATION_EXPIRATION_HOURS=120
EMERGENCY_ACCESS_ALLOWED=true
EMAIL_CHANGE_ALLOWED=true
PASSWORD_ITERATIONS=600000
PASSWORD_HINTS_ALLOWED=true
SHOW_PASSWORD_HINT=false
MAIL_ENABLED=false

# Enable the dedicated OIDC client after task 4; password login remains enabled.
SSO_ENABLED=true
SSO_ONLY=false
SSO_SIGNUPS_MATCH_EMAIL=true
SSO_ALLOW_UNKNOWN_EMAIL_VERIFICATION=false
SSO_AUTHORITY=https://auth.contentoren.de
SSO_SCOPES=email profile
SSO_AUTHORIZE_EXTRA_PARAMS=
SSO_PKCE=true
SSO_AUTH_ONLY_NOT_SESSION=false
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=

DISABLE_2FA_REMEMBER=false
AUTHENTICATOR_DISABLE_TIME_DRIFT=false
ENABLE_EMAIL_2FA=false
EMAIL_TOKEN_SIZE=6
EMAIL_EXPIRATION_TIME=600
EMAIL_ATTEMPTS_LIMIT=3
INCOMPLETE_2FA_TIME_LIMIT=3
WEBAUTHN_ENABLED=true
WEBAUTHN_RP_NAME=OneWarden
DUO_ENABLED=false
# DUO_HOST=
# DUO_IKEY=
# DUO_SKEY=
YUBICO_ENABLED=false
# YUBICO_CLIENT_ID=
# YUBICO_SECRET_KEY=
# YUBICO_SERVER=https://api.yubico.com
UNAUTHENTICATED_RATELIMIT_SECONDS=60
UNAUTHENTICATED_RATELIMIT_MAX_BURST=50

# SMTP is required only when MAIL_ENABLED=true.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
SMTP_TIMEOUT=15

PUSH_ENABLED=false
PUSH_RELAY_URI=https://push.bitwarden.com
PUSH_IDENTITY_URI=https://identity.bitwarden.com
# PUSH_INSTALLATION_ID=
# PUSH_INSTALLATION_KEY=

# Optional server features.
# USER_SEND_LIMIT=
INCREASE_NOTE_SIZE_LIMIT=false
# HIBP_API_KEY=
ADMIN_TOKEN=
DISABLE_ADMIN_TOKEN=false
ADMIN_SESSION_LIFETIME=20
INVITATION_ORG_NAME=OneWarden

# Icon cache and download policy.
DISABLE_ICON_DOWNLOAD=false
HTTP_REQUEST_BLOCK_NON_GLOBAL_IPS=true
# HTTP_REQUEST_BLOCK_REGEX=
ICON_CACHE_NEGTTL=259200
ICON_CACHE_TTL=604800
ICON_DOWNLOAD_TIMEOUT=10
ICON_REDIRECT_CODE=302
ICON_SERVICE=internal
